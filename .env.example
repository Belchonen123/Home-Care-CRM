# Copy to .env.local and fill in. Never commit real secrets.

# ---------------------------------------------------------------------------
# Convex (Prompt 1: required for `pnpm convex:dev` to work)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Clerk (added in Prompt 3 — auth wiring)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---------------------------------------------------------------------------
# PHI field-level encryption (added in Prompt 2)
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
PHI_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Geocoding (added in Prompt 7 — client intake)
# ---------------------------------------------------------------------------
MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# Twilio (added in Phase 3 — IVR EVV fallback)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------------------------------------------------------------------------
# Postmark (added in Prompt 8 — credential expiry alerts)
# ---------------------------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=alerts@example.com
